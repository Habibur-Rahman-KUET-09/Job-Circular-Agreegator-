rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;

      match /applications/{appId} {
        allow read: if request.auth.uid == userId;
        allow write: if request.auth.uid == userId;
      }

      match /savedJobs/{savedJobId} {
        allow read: if request.auth.uid == userId;
        allow write: if request.auth.uid == userId;
      }
    }

    // Jobs collection - core of the app
    match /jobs/{jobId} {
      // Read: Anyone can view jobs (public feed)
      allow read: if true;

      // Create: Only admin, moderator, recruiter can create jobs, always as
      // pending so a hand-entered job is reviewed before anyone sees it.
      // Recruiters can only create jobs for their own company.
      allow create: if request.auth != null
                    && request.auth.token.role in ['admin', 'moderator', 'recruiter']
                    && request.resource.data.status == 'pending'
                    && (request.auth.token.role != 'recruiter'
                        || request.resource.data.company == request.auth.token.company);

      // Update:
      // - Admin and moderator can update any job (moderators approve/reject
      //   scraped jobs, which nobody "posted")
      // - Recruiter can update only their own company's jobs they posted
      allow update: if request.auth != null
                    && (request.auth.token.role in ['admin', 'moderator']
                        || (request.auth.token.role == 'recruiter'
                            && resource.data.company == request.auth.token.company
                            && resource.data.postedBy == request.auth.uid
                            // Recruiters can't approve their own jobs.
                            && request.resource.data.status == resource.data.status));

      // Delete: Only admin can delete jobs
      allow delete: if request.auth != null
                    && request.auth.token.role == 'admin';
    }

    // Audit log collection (admin only)
    match /auditLog/{logId} {
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      allow create: if request.auth != null;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
